DRIVER=~fastapi
CUSTOM_FONT_PATH="fonts"
DEFAULT_FALLBACK_FONTS='["Noto Sans CJK SC", "Noto Color Emoji", "Noto Sans Symbols", "Noto Sans Symbols2", "Noto Sans Thai", "Noto Sans Kannada", "Noto Sans Cherokee", "Noto Sans"]'
SMTP_SERVER="smtp.qq.com"
SMTP_PORT=465
EMAIL_SENDER=
EMAIL_RECEIVER=
EMAIL_AUTH_CODE=
COOKIE=
BILI_REFRESH_TOKEN=
BOT_QQ=
NAPCAT_PATH=
FLASK_SECRET_KEY=
FLASK_INITIAL_PASSWORD=
GITHUB_PROXY="https://gh-proxy.com/"
ENABLE_OCR=true
COMMAND_START=[""]
API_KEY=
API_HOST=
AI_MODEL=qwen3.8-flash
AI_BACKEND=qwen
AI_FALLBACK_MODEL=qwen3.8-flash
# true使用PC的17890/17891跳板；断连使用Flash，后台定期重试并替换兜底摘要。
AI_CODEX_USE_PC_BRIDGE=true
# 不使用PC跳板时，可指定本机独立HTTP代理；留空时直连。
AI_CODEX_PROXY_URL=
AI_CODEX_CA_BUNDLE=
AI_CODEX_MODEL=gpt-6.1-sol
AI_CODEX_EFFORT=high
# Fast仅用于总结子进程，提高速度并增加订阅额度消耗；设为default可关闭。
AI_CODEX_SERVICE_TIER=fast
AI_CODEX_TIMEOUT_SECONDS=600
AI_CODEX_RETRY_SECONDS=300
AI_TIMEOUT_SECONDS=600
AI_MAX_OUTPUT_TOKENS=4000
# 群聊总结默认关闭，在群内使用“打开功能 在聊什么”开启查询和自动整理。
